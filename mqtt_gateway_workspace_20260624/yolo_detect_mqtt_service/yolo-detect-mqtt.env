# WXF YOLO Detect MQTT service environment.
# Robot install path:
# /data/wxf/wxf/mqtt_gateway_workspace_20260624/yolo_detect_mqtt_service/yolo-detect-mqtt.env
#
# The CPU service is the default for the Huixi robot body. For the future 4060
# deployment, keep this file as a template and use run_server_gpu.sh with a
# GPU-capable Python environment on the 4060 machine.

YOLO_DETECT_PYTHON=/data/wxf/wxf/mqtt_gateway_workspace_20260624/yolo/yolo-env/bin/python
YOLO_DETECT_BROKER=127.0.0.1
YOLO_DETECT_PORT=1883
YOLO_DETECT_REQUEST_TOPIC=/yolo_detect/
YOLO_DETECT_RESULT_TOPIC=/yolo_detect_result
YOLO_DETECT_MODEL=/data/wxf/wxf/mqtt_gateway_workspace_20260624/yolo_detect_mqtt_service/shelf.pt
YOLO_DETECT_DEVICE=cpu
YOLO_DETECT_WORK_DIR=/data/wxf/wxf/mqtt_gateway_workspace_20260624/yolo_detect_mqtt_service/runs
